stateDiagram-v2
    direction TB

    state "1. Indicador (ciclo acreditación)" as Indicador {
        [*] --> PENDIENTE: indicador creado<br/>desde plantilla proceso

        PENDIENTE --> EN_REVISION: "(CC) carga evidencia POST /documentos exitoso"

        EN_REVISION --> APROBADO: "(TD) aprueba UC-003 PATCH decision"
        EN_REVISION --> RECHAZADO: "(TD) rechaza con justificacion min 20 chars"

        RECHAZADO --> EN_REVISION: "(CC) sube nueva version documento"

        APROBADO --> EN_REVISION: "(CC) nueva version advertencia UI RB-04"

        note right of PENDIENTE
            Sin documento vigente
            CC puede primera carga
        end note

        note right of EN_REVISION
            Cola revision TD
            Notificacion CARGA
        end note

        note right of RECHAZADO
            Observacion visible CC
            Plan mejora opcional UC-012
        end note
    }

    state "2. Documento evidencia (versionado)" as Documento {
        [*] --> SIN_REGISTRO: sin fila documento

        SIN_REGISTRO --> VIGENTE_EN_REVISION: INSERT version 1..N<br/>hash SHA-256 en S3

        VIGENTE_EN_REVISION --> HISTORICO: nueva version INSERT<br/>versión anterior RB-04

        HISTORICO --> HISTORICO: solo lectura<br/>sin DELETE físico

        note right of HISTORICO
            Todas las versiones
            consultables en auditoría
        end note
    }

    state "3. Carga en UI CC" as CargaUI {
        [*] --> FORMULARIO_ABIERTO
        FORMULARIO_ABIERTO --> VALIDANDO_CLIENTE: seleccionar archivo
        VALIDANDO_CLIENTE --> FORMULARIO_ABIERTO: validación fallida
        VALIDANDO_CLIENTE --> SUBIENDO: POST multipart<br/>barra progreso NFR-009
        SUBIENDO --> FORMULARIO_ABIERTO: error 4xx/5xx
        SUBIENDO --> CONFIRMADO: 201 Created
        CONFIRMADO --> [*]
    }

    note right of Indicador
        Precondicion proceso EN_PROCESO
        BR-015: indicadorId obligatorio
        RB-02: solo CC asignado
    end note
