%% UC02 — FSD-UC-002 Carga evidencia (referencia)
%% Canónico: team/Marlene/07_diagramas/UC02_secuencia.mmd

sequenceDiagram
    autonumber
    actor CC as [CC]
    participant UI as SPA
    participant API as API
    participant S3 as Storage
    participant DB as PostgreSQL
    participant OUT as Outbox

    CC->>UI: adjuntar evidencia
    UI->>API: POST /documentos multipart
    API->>API: RB-02 RB-015 MIME tamaño
    alt error
        API-->>UI: 403 413 415
    else ok
        API->>S3: PUT archivo
        API->>DB: documento v++ indicador EN_REVISION
        API->>OUT: NOTIF_CARGA
        API-->>UI: 201
    end
