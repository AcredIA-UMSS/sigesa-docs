    Container(worker, "Worker notificaciones", "Node cron", "Cola notification_outbox")
    Container(pdf, "Motor reportes PDF", "Modulo en proceso", "FSD-UC-014 reporte ejecutivo")
  }

  System_Ext(idp, "Identidad UMSS", "SSO / LDAP — ADR_003")
  System_Ext(smtp, "SMTP institucional UMSS", "Notificaciones")
  System_Ext(ceub, "CEUB / ARCU-SUR", "Marco normativo acreditacion")

  Rel(cc, web, "HTTPS")
  Rel(td, web, "HTTPS")
  Rel(jd, web, "HTTPS")
  Rel(pub, web, "HTTPS lectura")
  Rel(ext, web, "HTTPS acotado")

  Rel(web, api, "JSON /api/v1")
