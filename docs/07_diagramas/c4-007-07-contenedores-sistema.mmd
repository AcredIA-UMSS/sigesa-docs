C4Container
  title SIGESA — Contenedores MVP (hybrid architecture, runtime local)
  Person(cc, "[CC] Coordinador de Carrera", "Carga y subsana Evidencia")
  Person(td, "[TD] Tecnico DUEA", "Valida Indicadores")

  System_Boundary(sigesa, "SIGESA / AcredIA — MVP") {
    Container(web, "Frontend", "Next.js 16 + React 19", "Rutas CC (/cc) y TD (/td); polling 30s")
    Container(gw, "API Gateway", "Node.js 22 + Express 4", ":8080 proxy unico /api/v1")
    Container(ev, "Evidence Service", "Node.js + Express", ":3001 hexagonal; upload S3; publica EvidenceUploaded")
    Container(audit, "Audit Service", "Node.js + Express", ":3002 auth, dashboards, approve/reject, consume eventos Evidence")
    Container(orch, "Orchestration Service", "Node.js + Express", ":3003 PhaseCloseRule; webhook serial (SQS FIFO pendiente prod)")
    Container(devbus, "Bus eventos dev", "HTTP webhooks internos", "Imita EventBridge: POST /internal/events + X-Internal-Events-Secret")
    ContainerDb(db, "PostgreSQL 16", "RDS local Docker", "Append-only: evidence_version, indicator_state_history, observation")
    ContainerDb(blob, "Object storage", "MinIO (dev) / S3 (prod)", "Blobs Evidence SHA-256 — ADR-0013")
    ContainerDb(outbox, "notification_outbox", "Tabla PostgreSQL", "Esquema listo; worker SMTP NO implementado en MVP")
  }

  System_Ext(idp, "Identidad UMSS", "Prod: LDAP/SSO. Dev: login local @umss.edu.bo")
  System_Ext(aws_prod, "AWS prod (target v1.0)", "EventBridge + SQS FIFO + SMTP")
  System_Ext(ceub, "CEUB / ARCU-SUR", "Marco normativo")

  Rel(cc, web, "HTTPS")
  Rel(td, web, "HTTPS")
  Rel(web, gw, "JSON /api/v1")
  Rel(gw, ev, "Proxy evidences")
  Rel(gw, audit, "Proxy auth, audit, dashboard")

  Rel(ev, blob, "PutObject / presigned GET")
  Rel(ev, db, "INSERT evidence_version")
  Rel(ev, devbus, "publish EvidenceUploaded / EvidenceSubsanated")
  Rel(devbus, audit, "POST /internal/events")
  Rel(audit, db, "INSERT indicator_state_history, observation")
  Rel(audit, devbus, "publish IndicatorApproved")
  Rel(devbus, orch, "POST /internal/events")
  Rel(orch, db, "INSERT phase_state_history si COUNT(APROBADO)==TOTAL")

  Rel(audit, idp, "Dev: AuthPort en servicio. Prod: adapter LDAP")
  Rel(devbus, aws_prod, "Prod: reemplazar por EventBridge + SQS FIFO")
  Rel(outbox, aws_prod, "Futuro: Notification Service + SMTP")
  Rel(sigesa, ceub, "Taxonomias en BD seed")
