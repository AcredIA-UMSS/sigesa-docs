# PostgreSQL
DATABASE_URL=postgresql://sigesa:sigesa_dev@localhost:5432/sigesa

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sigesa-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# JWT (dev only — rotate in production)
JWT_SECRET=dev-sigesa-jwt-change-in-production
JWT_EXPIRES_IN=8h

# Service URLs (docker network / local)
EVIDENCE_SERVICE_URL=http://localhost:3001
AUDIT_SERVICE_URL=http://localhost:3002
ORCHESTRATION_SERVICE_URL=http://localhost:3003
GATEWAY_PORT=8080

# Event delivery (evidence → audit internal webhook, dev)
AUDIT_INTERNAL_EVENTS_URL=http://localhost:3002/internal/events
INTERNAL_EVENTS_SECRET=dev-internal-secret

# Orchestration (phase 2 — SQS FIFO stub uses in-memory in dev)
SQS_FIFO_QUEUE_URL=
AWS_REGION=us-east-1
